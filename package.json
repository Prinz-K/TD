{
  "name": "brainrot-td",
  "version": "1.0.0",
  "description": "Bloons-style tower defense with brainrot characters",
  "private": true,
  "scripts": {
    "start": "python3 -m http.server 8000",
    "build": "node build-www.mjs",
    "cap:add:android": "npm run build && cap add android",
    "cap:add:ios": "npm run build && cap add ios",
    "cap:sync": "npm run build && cap sync",
    "cap:open:android": "cap open android",
    "cap:open:ios": "cap open ios"
  },
  "dependencies": {
    "@capacitor/android": "^6.1.0",
    "@capacitor/core": "^6.1.0",
    "@capacitor/ios": "^6.1.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.1.0"
  }
}
